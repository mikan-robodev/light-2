int(150, 255), randint(150, 255), randint(150, 255)))\n        }\n        strip.show()\n    }\n})\ninput.onButtonPressed(Button.AB, function () {\n    if (first_press) {\n        positions = [randint(0, 299)]\n        first_press = false\n    } else {\n        newPos = (positions[positions.length - 1] - 1 + 300) % 300\n        positions.push(newPos)\n    }\n    scattered = false\n    strip.clear()\n    for (let p of positions) {\n        strip.setPixelColor(p, neopixel.rgb(randint(150, 255), randint(150, 255), randint(150, 255)))\n    }\n    strip.show()\n})\ninput.onButtonPressed(Button.B, function () {\n    if (!(first_press)) {\n        for (let l = 0; l <= positions.length - 1; l++) {\n            positions[l] = (positions[l] + 1) % 300\n        }\n        scattered = false\n        strip.clear()\n        for (let r of positions) {\n            strip.setPixelColor(r, neopixel.rgb(randint(150, 255), randint(150, 255), randint(150, 255)))\n        }\n        strip.show()\n    }\n})\ninput.onGesture(Gesture.Shake, function () {\n    if (!(first_press)) {\n        if (!(scattered)) {\n            saved_positions = positions.slice()\nstrip.clear()\n            for (let i = 0; i <= positions.length - 1; i++) {\n                positions[i] = randint(0, 299)\n                strip.setPixelColor(positions[i], neopixel.rgb(randint(150, 255), randint(150, 255), randint(150, 255)))\n            }\n            strip.show()\n            scattered = true\n        } else {\n            positions = saved_positions.slice()\nstrip.clear()\n            for (let j = 0; j <= positions.length - 1; j++) {\n                strip.setPixelColor(positions[j], neopixel.rgb(randint(150, 255), randint(150, 255), randint(150, 255)))\n            }\n            strip.show()\n            scattered = false\n        }\n    }\n})\nlet newPos = 0\nlet scattered = false\nlet strip: neopixel.Strip = null\nlet first_press = false\nlet saved_positions: number[] = []\nlet positions: number[] = []\nfirst_press = true\nstrip = neopixel.create(DigitalPin.P0, 300, NeoPixelMode.RGB)\npositions = []\nfirst_press = true\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    if (positions.length > 0) {\n        positions.pop()\n        strip.clear()\n        for (let p of positions) {\n            strip.setPixelColor(p, neopixel.rgb(randint(150, 255), randint(150, 255), randint(150, 255)))\n        }\n        strip.show()\n    }\n    if (positions.length == 0) {\n        first_press = true\n    }\n})","README.md":"","main.py":"strip: neopixel.Strip = None\npos = 0\nlength = 1\nstrip = neopixel.create(DigitalPin.P0, 300, NeoPixelMode.RGB)\npos = 0\nlength = 1\n\ndef on_button_pressed_ab():\n    global pos\n    pos = randint(0, 299)\n    strip.clear()\n    strip.range(pos, length).show_color(neopixel.colors(NeoPixelColors.RED))\ninput.on_button_pressed(Button.AB, on_button_pressed_ab)\n\ndef on_button_pressed_a():\n    global pos\n    pos = max(0, pos - 1)\n    strip.clear()\n    strip.range(pos, length).show_color(neopixel.colors(NeoPixelColors.RED))\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef on_button_pressed_b():\n    global pos\n    pos = min(299, pos + 1)\n    strip.clear()\n    strip.range(pos, length).show_color(neopixel.colors(NeoPixelColors.RED))\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n","pxt.json":"{\n    \"name\": \"light 2\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"neopixel\": \"github:microsoft/pxt-neopixel#v0.7.6\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1795143843024}