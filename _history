:\n        current_pos = (current_pos + 1) % num_pixels\n        update_lights()\n        sleep(200)\n\n    # Button B moves backward up the string\n    elif button_b.is_pressed() and not button_a.is_pressed():\n        current_pos = (current_pos - 1) % num_pixels\n        update_lights()\n        sleep(200)\n\n    # Pressing A and B together adds a light safely\n    elif button_a.is_pressed() and button_b.is_pressed():\n        if num_pixels < 30:\n            num_pixels += 1\n            np = neopixel.NeoPixel(pin0, num_pixels)\n            update_lights()  # Clears any glitches on the new strip\n            sleep(300)\n\n    # Shaking the micro:bit deletes a light safely\n    elif accelerometer.was_gesture('shake'):\n        if num_pixels > 1:\n            num_pixels -= 1\n            np = neopixel.NeoPixel(pin0, num_pixels)\n            # Fix position if it is now past the shorter strip limit\n            if current_pos >= num_pixels:\n                current_pos = num_pixels - 1\n            update_lights()\n            sleep(300)","pxt.json":"{\n    \"name\": \"light 2\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"neopixel\": \"github:microsoft/pxt-neopixel#v0.7.6\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\"\n}\n"}},{"timestamp":1795141958259,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block></xml>","main.ts":"let strip: neopixel.Strip = null\nlet pos = 0\nlet length = 1\n\nstrip = neopixel.create(DigitalPin.P0, 300, NeoPixelMode.RGB)\npos = 0\nlength = 1\n\ninput.onButtonPressed(Button.AB, function () {\n    pos = randint(0, 299)\n    strip.clear()\n    strip.range(pos, length).showColor(neopixel.colors(NeoPixelColors.Red))\n})\n\ninput.onButtonPressed(Button.A, function () {\n    pos = Math.max(0, pos - 1)\n    strip.clear()\n    strip.range(pos, length).showColor(neopixel.colors(NeoPixelColors.Red))\n})\n\ninput.onButtonPressed(Button.B, function () {\n    pos = Math.min(299, pos + 1)\n    strip.clear()\n    strip.range(pos, length).showColor(neopixel.colors(NeoPixelColors.Red))\n})","README.md":"","main.py":"strip: neopixel.Strip = None\npos = 0\nlength = 1\nstrip = neopixel.create(DigitalPin.P0, 300, NeoPixelMode.RGB)\npos = 0\nlength = 1\n\ndef on_button_pressed_ab():\n    global pos\n    pos = randint(0, 299)\n    strip.clear()\n    strip.range(pos, length).show_color(neopixel.colors(NeoPixelColors.RED))\ninput.on_button_pressed(Button.AB, on_button_pressed_ab)\n\ndef on_button_pressed_a():\n    global pos\n    pos = max(0, pos - 1)\n    strip.clear()\n    strip.range(pos, length).show_color(neopixel.colors(NeoPixelColors.RED))\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef on_button_pressed_b():\n    global pos\n    pos = min(299, pos + 1)\n    strip.clear()\n    strip.range(pos, length).show_color(neopixel.colors(NeoPixelColors.RED))\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n","pxt.json":"{\n    \"name\": \"light 2\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"neopixel\": \"github:microsoft/pxt-neopixel#v0.7.6\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1795143843013,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"-6TcFlQQ2`.]Y{]Cx;gu\">first_press</variable><variable id=\":$sCcIJ~,{mRI;e)]^#O\">scattered</variable><variable id=\"HeA{Et,Z5sy%!:I%YZHj\">strip</variable><variable id=\"y18(6gu]vL|2Qy)yt?Ha\"