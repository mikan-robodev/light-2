[[1,"# Set the first pixel (index 0) to red (Red, Green, Blue)\nnp[0] = (255, 0, 0)\n"]]},{"start1":232,"length1":1366,"diffs":[[1,"# Send the data to the strip so it lights up\nnp.show()"]]}]}]},{"timestamp":1795062848935,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.py","patch":[{"start1":0,"length1":0,"diffs":[[1,"from microbit import *\nimport neopixel\n\n# Set up a strip of 8 pixels on pin 0\nnum_pixels = 8\nnp = neopixel.NeoPixel(pin0, num_pixels)\n\n# Starting position of our active light\ncurrent_pos = 0\n\ndef update_lights():\n    # Clear all lights to off (black)\n    for i in range(num_pixels):\n        np[i] = (0, 0, 0)\n    # Turn on only the current light (green)\n    np[current_pos] = (0, 255, 0)\n    np.show()\n\nupdate_lights()\n\nwhile True:\n    # Button A moves forward down the string\n    if button_a.is_pressed() and not button_b.is_pressed():\n        current_pos = (current_pos + 1) % num_pixels\n        update_lights()\n        sleep(200)\n\n    # Button B moves backward up the string\n    elif button_b.is_pressed() and not button_a.is_pressed():\n        current_pos = (current_pos - 1) % num_pixels\n        update_lights()\n        sleep(200)\n\n    # Pressing A and B together adds a light safely\n    elif button_a.is_pressed() and button_b.is_pressed():\n        if num_pixels < 30:\n            num_pixels += 1\n            np = neopixel.NeoPixel(pin0, num_pixels)\n            update_lights()  # Clears any glitches on the new strip\n            sleep(300)\n\n    # Shaking the micro:bit deletes a light safely\n    elif accelerometer.was_gesture('shake'):\n        if num_pixels > 1:\n            num_pixels -= 1\n            np = neopixel.NeoPixel(pin0, num_pixels)\n            # Fix position if it is now past the shorter strip limit\n            if current_pos >= num_pixels:\n                current_pos = num_pixels - 1\n            update_lights()\n            sleep(300)"]]}]}]},{"timestamp":1795063467806,"editorVersio